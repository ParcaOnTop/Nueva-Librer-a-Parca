local function getCalcStrength()
	local ok, val = pcall(function()
		local s = leaderstats:FindFirstChild("Strength")
		return s and tonumber(s.Value) or 0
	end)
	return ok and val or 0
end

local function getCalcDurability()
	local ok, val = pcall(function()
		local d = (leaderstats and leaderstats:FindFirstChild("Durability")) or LocalPlayer:FindFirstChild("Durability")
		return d and tonumber(d.Value) or 0
	end)
	return ok and val or 0
end

local function formatCalcNumber(number)
	local num = tonumber(number) or 0
	local isNegative = num < 0
	num = math.abs(num)
	if num >= 1e15 then
		return (isNegative and "-" or "") .. string.format("%.2fQa", num / 1e15)
	elseif num >= 1e12 then
		return (isNegative and "-" or "") .. string.format("%.2fT", num / 1e12)
	elseif num >= 1e9 then
		return (isNegative and "-" or "") .. string.format("%.2fB", num / 1e9)
	elseif num >= 1e6 then
		return (isNegative and "-" or "") .. string.format("%.2fM", num / 1e6)
	elseif num >= 1e3 then
		return (isNegative and "-" or "") .. string.format("%.2fK", num / 1e3)
	else
		return (isNegative and "-" or "") .. string.format("%.2f", num)
	end
end

