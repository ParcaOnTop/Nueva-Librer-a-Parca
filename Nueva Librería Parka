	Title = "Durability Rate",
	Desc = "0.00/Hour | 0.00/Day | 0.00/Week | 0.00/Month",
})

CalculadoraTab:Paragraph({
	Title = "Stats:",
	Desc = "Resumen de sesión",
})

local strengthLabel = CalculadoraTab:Paragraph({
	Title = "Strength",
	Desc = "Strength: 0.00 | Gained: 0.00",
})

local durabilityLabel = CalculadoraTab:Paragraph({
	Title = "Durability",
	Desc = "Durability: 0.00 | Gained: 0.00",
})

local calcStartTime = os.clock()
local initialStrength = getCalcStrength()
local initialDurability = getCalcDurability()
local strengthHistory = {}
local durabilityHistory = {}
local calculationInterval = 10

local function resetCalculadora()
	calcStartTime = os.clock()
	initialStrength = getCalcStrength()
	initialDurability = getCalcDurability()
	strengthHistory = { { time = calcStartTime, value = initialStrength } }
	durabilityHistory = { { time = calcStartTime, value = initialDurability } }

	setParagraphSafe(stopwatchLabel, "Fast Rep Time", "0d 0h 0m 0s")
	setParagraphSafe(strengthLabel, "Strength", "Strength: " .. formatCalcNumber(initialStrength) .. " | Gained: 0.00")
	setParagraphSafe(durabilityLabel, "Durability", "Durability: " .. formatCalcNumber(initialDurability) .. " | Gained: 0.00")
	setParagraphSafe(projectedStrengthLabel, "Strength Rate", "0.00/Hour | 0.00/Day | 0.00/Week | 0.00/Month")
	setParagraphSafe(projectedDurabilityLabel, "Durability Rate", "0.00/Hour | 0.00/Day | 0.00/Week | 0.00/Month")
end

CalculadoraTab:Button({
	Title = "Reiniciar Calculadora",
	Desc = "Pone en cero el tiempo de sesión y las ganancias calculadas",
	Icon = "rotate-ccw",
	Callback = function()
		resetCalculadora()
		WindUI:Notify({
			Title = "Calculadora Reiniciada",
			Content = "Contadores de tiempo y ganancias reiniciados.",
			Icon = "rotate-ccw",
			Duration = 2,
		})
	end,
})

resetCalculadora()

task.spawn(function()
	local lastCalcTime = os.clock()
	while true do
		local currentTime = os.clock()
		local currentStrength = getCalcStrength()
		local currentDurability = getCalcDurability()

		local elapsedTime = math.max(0, currentTime - calcStartTime)
		local days = math.floor(elapsedTime / (24 * 3600))
		local hours = math.floor((elapsedTime % (24 * 3600)) / 3600)
		local minutes = math.floor((elapsedTime % 3600) / 60)
		local seconds = math.floor(elapsedTime % 60)

		setParagraphSafe(
			stopwatchLabel,
			"Fast Rep Time",
			string.format("%dd %dh %dm %ds", days, hours, minutes, seconds)
		)

		local sessionStrengthDelta = currentStrength - initialStrength
		local sessionDurabilityDelta = currentDurability - initialDurability

		setParagraphSafe(
			strengthLabel,
			"Strength",
			"Strength: " .. formatCalcNumber(currentStrength) .. " | Gained: " .. formatCalcNumber(sessionStrengthDelta)
		)
		setParagraphSafe(
			durabilityLabel,
			"Durability",
			"Durability: " .. formatCalcNumber(currentDurability) .. " | Gained: " .. formatCalcNumber(sessionDurabilityDelta)
		)

		table.insert(strengthHistory, { time = currentTime, value = currentStrength })
		table.insert(durabilityHistory, { time = currentTime, value = currentDurability })

		while #strengthHistory > 0 and currentTime - strengthHistory[1].time > calculationInterval do
			table.remove(strengthHistory, 1)
		end
		while #durabilityHistory > 0 and currentTime - durabilityHistory[1].time > calculationInterval do
			table.remove(durabilityHistory, 1)
		end

		if currentTime - lastCalcTime >= calculationInterval then
			lastCalcTime = currentTime

			if #strengthHistory >= 2 then
				local dt = math.max(0.1, strengthHistory[#strengthHistory].time - strengthHistory[1].time)
				local strengthDelta = strengthHistory[#strengthHistory].value - strengthHistory[1].value
				local strengthPerSecond = strengthDelta / dt

				setParagraphSafe(
					projectedStrengthLabel,
					"Strength Rate",
					formatCalcNumber(math.floor(strengthPerSecond * 3600)) .. "/Hour | "
						.. formatCalcNumber(math.floor(strengthPerSecond * 86400)) .. "/Day | "
						.. formatCalcNumber(math.floor(strengthPerSecond * 604800)) .. "/Week | "
						.. formatCalcNumber(math.floor(strengthPerSecond * 2592000)) .. "/Month"
				)
			end

			if #durabilityHistory >= 2 then
				local dt = math.max(0.1, durabilityHistory[#durabilityHistory].time - durabilityHistory[1].time)
				local durabilityDelta = durabilityHistory[#durabilityHistory].value - durabilityHistory[1].value
				local durabilityPerSecond = durabilityDelta / dt

				setParagraphSafe(
					projectedDurabilityLabel,
					"Durability Rate",
					formatCalcNumber(math.floor(durabilityPerSecond * 3600)) .. "/Hour | "
						.. formatCalcNumber(math.floor(durabilityPerSecond * 86400)) .. "/Day | "
						.. formatCalcNumber(math.floor(durabilityPerSecond * 604800)) .. "/Week | "
						.. formatCalcNumber(math.floor(durabilityPerSecond * 2592000)) .. "/Month"
				)
			end
		end

		task.wait(0.25)
	end
end)
