-- Función Anti-Lag (Botón de optimización)
local function activarAntiLag()
	pcall(function()
		settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
	end)

	Lighting.GlobalShadows = false
	Lighting.FogEnd = 9e9

	for _, effect in ipairs(Lighting:GetChildren()) do
		if effect:IsA("PostEffect") or effect:IsA("BlurEffect") or effect:IsA("SunRaysEffect") or effect:IsA("ColorCorrectionEffect") or effect:IsA("BloomEffect") or effect:IsA("DepthOfFieldEffect") then
			effect.Enabled = false
		end
	end

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") then
			obj.Material = Enum.Material.Plastic
			obj.Reflectance = 0
			obj.CastShadow = false
		elseif obj:IsA("Decal") or obj:IsA("Texture") then
			obj.Transparency = 1
		elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
			obj.Enabled = false
		end
	end

	WindUI:Notify({
		Title = "Anti-Lag Activado",
		Content = "Gráficos, sombras y partículas optimizados.",
		Icon = "zap",
		Duration = 3,
	})
end

PrincipalTab:Button({
	Title = "Activar Anti-Lag",
	Desc = "Reduce sombras, texturas, partículas y calidad gráfica para subir FPS",
	Icon = "zap",
	Callback = function()
		activarAntiLag()
	end,
})

