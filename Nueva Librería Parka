local FarmToolsList = { "Weight", "Pushups", "Handstands", "Situps" }
local selectedTool = "Weight"

local function equipToolByName(toolName)
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if not character or not humanoid or not backpack then
		return false
	end

	if character:FindFirstChild(toolName) then
		return true
	end

	local tool = backpack:FindFirstChild(toolName)
	if tool and tool:IsA("Tool") then
		pcall(function()
			humanoid:EquipTool(tool)
		end)
		return true
	end
	return false
end

local function unequipToolsByList(toolList)
	local character = LocalPlayer.Character
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if not character or not backpack then
		return
	end

	for _, toolName in ipairs(toolList) do
		local equipped = character:FindFirstChild(toolName)
		if equipped and equipped:IsA("Tool") then
			pcall(function()
				equipped.Parent = backpack
			end)
		end
	end
end

